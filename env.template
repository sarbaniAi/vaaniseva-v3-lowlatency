# =============================================================================
# VaaniSeva v2 — Environment Variables Template
# Copy to .env and fill in your values: cp env.template .env
# =============================================================================

# --- Databricks Workspace ---
DATABRICKS_HOST=https://adb-xxxx.yy.azuredatabricks.net
# PAT token for local development (Databricks Apps use OAuth automatically)
DATABRICKS_TOKEN=
# CLI profile name (run: databricks auth login --host <url> --profile <name>)
DATABRICKS_PROFILE=DEFAULT

# --- Lakebase (Autoscaling PostgreSQL) ---
LAKEBASE_PROJECT=vaaniseva
LAKEBASE_BRANCH=production
LAKEBASE_ENDPOINT=primary
LAKEBASE_HOST=
LAKEBASE_DB_NAME=vaaniseva

# --- Sarvam AI (https://dashboard.sarvam.ai) ---
# Sign up at https://dashboard.sarvam.ai — free tier available
# Used for: STT (saaras:v3) and TTS (bulbul:v2, anushka voice)
SARVAM_API_KEY=

# --- OpenAI (https://platform.openai.com) ---
# Used for: LLM brain (GPT-4o) — handles conversation logic
OPENAI_API_KEY=

# --- LiveKit Cloud (https://livekit.io/cloud) ---
# Sign up free → create project → copy credentials
# Used for: Real-time voice transport (WebRTC + SIP bridge)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LiveKit SIP (for outbound phone calls) ---
# Created via: lk sip outbound create outbound-trunk.json
# See README.md "Phone Call Setup" section
SIP_OUTBOUND_TRUNK_ID=

# --- Twilio (https://console.twilio.com) ---
# Used for: SIP trunk (PSTN connectivity) + WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Optional ---
SARVAM_ENDPOINT_NAME=sarvam-30b-serving
VS_ENDPOINT_NAME=
VS_INDEX_NAME=
GENIE_SPACE_ID=
LOG_LEVEL=INFO
